{
  "name": "wingroove-reboot",
  "version": "1.2.0",
  "description": "A modern remake of the classic WinGroove software-wavetable MIDI player, using the WinGroove SoundFont.",
  "main": "main.js",
  "homepage": "https://github.com/Kenjiquest777/Wingroove-Reboot",
  "scripts": {
    "start": "electron .",
    "fetch-soundfont": "node scripts/fetch-soundfont.js",
    "postinstall": "node scripts/fetch-soundfont.js --soft",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "web": "npx --yes http-server renderer -p 8080 -c-1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.kenjiquest777.wingroovereboot",
    "productName": "WinGroove Reboot",
    "artifactName": "WinGroove-Reboot-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "soundfonts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "soundfonts",
        "to": "soundfonts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "soundfonts",
        "to": "soundfonts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    }
  }
}
